<?xml version="1.0"?>
<ruleset name="GitSupport Engine Coding Standards">
    <description>Custom PHPCS ruleset for the GitSupport Engine plugin.</description>

    <!-- Lint PHP files only -->
    <arg name="extensions" value="php"/>

    <!-- Show progress, show sniff names, and use colors -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Exclude external dependencies, system paths, and tests -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- Include WordPress rulesets -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- Global namespace prefixing rules -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <value>GitSupport\Engine</value>
                <value>gitsupport_engine</value>
                <value>GITSUPPORT_ENGINE</value>
            </property>
        </properties>
    </rule>

</ruleset>
